# Copy to `.env` (gitignored - never commit real secrets) and fill in what
# you need. This file is one of several credential providers the app supports,
# resolved in order (first hit wins): the process environment, this `.env`
# file, your OS keychain, then ~/.config/x-bookmarks-organizer/credentials.json.
# See README.md "Secrets" for details.

# X OAuth 2.0 app Client ID (required for `login`/`run`; see docs/setup.md).
XBOOKMARKS_CLIENT_ID=

# X OAuth 2.0 app Client Secret (required for `login`/`run`).
XBOOKMARKS_CLIENT_SECRET=

# Claude subscription token - OPTIONAL. A `claude` CLI you have logged into
# interactively (`claude` once) needs none of this; set it only for a headless
# machine with no interactive login. It is also what the OPT-IN
# `pi-claude-subscription` provider hands pi - a route Anthropic's Claude Code
# terms prohibit, at the risk of your account (see the README). Having the token
# here selects nothing: that provider runs only on a pass you put it on.
CLAUDE_CODE_OAUTH_TOKEN=

# TypeSafe/Jev API key - OPTIONAL. Read by XBOOKMARKS_CATEGORIZER=typesafe
# (routes the ASSIGNMENT pass through the TypeSafe API, opt-in) and by the
# ranking pass (`rank`, or "Rank now" in the app), which is available by
# default but does nothing without this key. Both are PAID PER TOKEN. The key
# alone spends nothing: the categorizer still needs its opt-in, `rank` still
# has to be invoked, and the in-app run still needs its explicit confirmation.
TYPESAFE_API_KEY=

# pi-ai model providers - OPTIONAL, PAID PER TOKEN. Read only when a
# categorization pass is set to the `pi-ai` provider (Settings, or
# XBOOKMARKS_TAXONOMY_PROVIDER / XBOOKMARKS_ASSIGNMENT_PROVIDER), and only the
# key for that pass's model's upstream. ANTHROPIC_API_KEY must be an API key
# (sk-ant-api...), never a Claude subscription token - use the default
# `claude-cli` provider for your subscription.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# A local OpenAI-compatible server (Ollama, LM Studio, vLLM) for "local/<model>" ids.
XBOOKMARKS_PIAI_BASE_URL=
