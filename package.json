{
  "name": "x-bookmarks-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "Fetch your X bookmarks, auto-categorize them into a nested topic tree with an LLM, store them locally in SQLite, and browse them in a local web viewer.",
  "license": "MIT",
  "author": "Ignacio Palacios",
  "type": "commonjs",
  "bin": {
    "xbo": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.js",
    "seed:dev": "node scripts/seed-dev-db.js",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "login": "node dist/index.js login",
    "backfill-previews": "node dist/index.js backfill-previews",
    "backfill-x-articles": "node dist/index.js backfill-x-articles",
    "clear-summaries": "node dist/index.js clear-summaries",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@fastify/static": "^10.1.3",
    "@mozilla/readability": "^0.6.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^11.8.1",
    "dompurify": "^3.4.15",
    "fastify": "^5.2.1",
    "linkedom": "^0.18.13",
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.7",
    "twitter-api-v2": "^1.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
