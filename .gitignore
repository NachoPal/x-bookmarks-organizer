# Secrets / credentials - never commit API keys or tokens
.env
.env.*
!.env.example
*.pem
*_token
*.secret

# Credential chain's owner-only config file fallback
credentials.json

# Local bookmark database (personal data, owned locally, not versioned)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite*

# Categorizer comparison reports (`eval-categorizers`) - derived from personal data
data/eval/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Common language/tooling artifacts (stack finalized during build)
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
*.log
